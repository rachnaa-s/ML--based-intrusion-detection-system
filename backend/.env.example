# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ids_db
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ids_db?retryWrites=true&w=majority
